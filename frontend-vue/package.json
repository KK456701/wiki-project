{
  "name": "wiki-agent-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "test:autonomous": "node --experimental-strip-types --test tests/autonomousActivity.test.mjs",
    "test:standard": "vitest run tests/standardDiagnosisStepper.spec.ts tests/standardDataConfirmationEditor.spec.ts tests/batchReportSnapshot.spec.ts",
    "test:sql-preview": "vitest run tests/sqlExecuteButton.spec.ts"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.8"
  }
}
