{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-004-001",
  "rule_name": "手术患者特级护理/一级护理出院率",
  "category": "分级护理制度",
  "definition": "手术患者出院时为特级护理/一级护理级别的患者数量占同期手术患者总数量的比例。",
  "formula": "分子：手术患者出院时为特级护理/一级护理级别的患者数量\n分母：同期手术患者总数量\n公式：手术患者出院时为特级护理/一级护理级别的患者数量 / 同期手术患者总数量 * 100%",
  "note": "——",
  "significance": "反映对住院患者进行分级护理动态调整的情况。",
  "default_profile": "HXZD-004-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-004-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "admitted_to_ward_at",
      "patient_scope": [
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "lower_is_better",
      "numerator_rule": "手术患者出院时为特级护理/一级护理级别的患者数量",
      "numerator_caliber": "1、单位时间内出区的手术患者中，最后一条护理医嘱为特级或一级护理的患者数\n2、说明：手术患者判断时，只需要统计手术类型为手术、介入治疗，排除诊断性操作、治疗性操作的数据以及日间手术。",
      "denominator_rule": "同期手术患者总数量",
      "denominator_caliber": "1、单位时间内出区的手术患者人数\n2、手术数据来源：取病案首页中有手术数据的患者数，一个患者多条手术统计1）",
      "configurable_parameters": "无。",
