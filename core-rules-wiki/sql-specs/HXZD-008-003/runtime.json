{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-008-003",
  "rule_name": "术前讨论计划手术一致率",
  "category": "术前讨论制度",
  "definition": "实际开展手术与术前讨论计划手术一致的手术例数占同期手术总例数的比例。",
  "formula": "分子：实际开展手术与术前讨论计划手术一致的手术例数\n分母：同期手术总例数\n公式：实际开展手术与术前讨论计划手术一致的手术例数 / 同期手术总例数 * 100%",
  "note": "——",
  "significance": "反映术前讨论质量。",
  "default_profile": "HXZD-008-003-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-008-003-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "surgery_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "实际开展手术与术前讨论计划手术一致的手术例数",
      "numerator_caliber": "1、单位时间内完成手术的患者中，手术记录（病历）的手术名称与术前讨论记录（病历）中的手术名称一致的数量（一条记录中有多个手术，任意一个相同，即算作一致）\n2、说明：手术患者判断时，只需要统计手术类型=手术、介入治疗，排除诊断性操作、治疗性操作的数据\n3、说明：EMR的术前讨论记录跟手术记录目前没有关联关系，可通过手术记录创建前48h内，最近的一份术前讨论记录来做对比。\n4、一个人多次手术算多次。",
      "denominator_rule": "同期手术总例数",
      "denominator_caliber": "单位时间内完成手术的患者总例数（手术完成时间取医生站）",
      "configurable_parameters": "无。",
      "declared_parameters": [
