{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-009-003",
  "rule_name": "科主任主持死亡病例讨论率",
  "category": "死亡病例讨论制度",
  "definition": "死亡病例讨论由科主任主持的病例数量占同期死亡病例总数量的比例。",
  "formula": "分子：死亡病例讨论由科主任主持的病例数量\n分母：同期死亡病例总数量\n公式：死亡病例讨论由科主任主持的病例数量 / 同期死亡病例总数量 * 100%",
  "note": "——",
  "significance": "反映死亡病例讨论制度落实和管理情况。",
  "default_profile": "HXZD-009-003-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-009-003-company-default",
      "profile_name": "推荐方案：科主任数据来源：死亡讨论记录病历模板限制主持人只能选科主任（需现场调整病历模板）",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "death_at",
      "patient_scope": [
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "死亡病例讨论由科主任主持的病例数量",
      "numerator_caliber": "单位时间内死亡的患者数，完成死亡病例讨论记录数量（需要病历模板中“主持人”下拉限定只能选择科主任）。",
      "denominator_rule": "同期死亡病例总数量",
      "denominator_caliber": "1、单位时间内死亡的患者数\n2、取病案首页中转归情况=死亡，死亡时间取病案中的出院时间",
      "configurable_parameters": "无。",
