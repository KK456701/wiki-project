      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "report_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "lower_is_better",
      "numerator_rule": "不适用（中位数指标；X为每条业务记录的报告耗时）",
      "numerator_caliber": "",
      "denominator_rule": "不适用（中位数指标；n为纳入统计的有效业务记录数）",
      "denominator_caliber": "",
      "configurable_parameters": "无。",
