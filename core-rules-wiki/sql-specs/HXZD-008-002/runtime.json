{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-008-002",
  "rule_name": "术者参加术前讨论率",
  "category": "术前讨论制度",
  "definition": "术者参加术前讨论的手术例数占同期进行术前讨论手术总例数的比例。",
  "formula": "分子：术者参加术前讨论的手术例数\n分母：同期进行术前讨论手术总例数\n公式：术者参加术前讨论的手术例数 / 同期进行术前讨论手术总例数 * 100%",
  "note": "本指标中术者是指手术的主要完成人。",
  "significance": "反映术前讨论规范性。",
  "default_profile": "HXZD-008-002-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-008-002-company-default",
      "profile_name": "推荐方案：按病历完成时间统计",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "admitted_to_ward_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "术者参加术前讨论的手术例数",
      "numerator_caliber": "单位时间内完成的术前讨论记录（病历）中，讨论人或主持人包含手术记录（病历）中手术医师的数量\n说明：EMR的术前讨论记录跟手术记录没有关联关系，本指标通过手术记录创建前48h内书写的最近一份术前讨论记录来做对比",
      "denominator_rule": "同期进行术前讨论手术总例数",
      "denominator_caliber": "单位时间内完成术前讨论记录的数量",
      "configurable_parameters": "无。",
