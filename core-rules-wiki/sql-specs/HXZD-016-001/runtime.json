{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-016-001",
  "rule_name": "临床用血后评估记录率",
  "category": "临床用血审核制度",
  "definition": "输血治疗后规范书写评估输血记录例次数占同期临床输血治疗病例总例次数的比例。",
  "formula": "分子：输血治疗后规范书写评估输血记录例次数\n分母：同期临床输血治疗病例总例次数\n公式：输血治疗后规范书写评估输血记录例次数 / 同期临床输血治疗病例总例次数 * 100%",
  "note": "——",
  "significance": "反映临床用血治疗的规范性。",
  "default_profile": "HXZD-016-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-016-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "order_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "输血治疗后规范书写评估输血记录例次数",
      "numerator_caliber": "1、单位时间内用血的患者中，完成用血记录的数量\n2、取病历文书中监控类型=输血病程记录的数据",
      "denominator_rule": "同期临床输血治疗病例总例次数",
      "denominator_caliber": "1、单位时间内用血医嘱总数\n2、说明：备血和用血都是属于用血医嘱，需要通过关联关系去重\n3、不包含已失效和已作废的医嘱",
