{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-008-001",
  "rule_name": "术前讨论完成率",
  "category": "术前讨论制度",
  "definition": "完成术前讨论的手术例数占同期手术总例数的比例。",
  "formula": "分子：完成术前讨论的手术例数\n分母：同期手术总例数\n公式：完成术前讨论的手术例数 / 同期手术总例数 * 100%",
  "note": "除以抢救生命为目的的急诊手术外，术前讨论完成时间晚于手术医嘱开具时间和手术同意书签署时间的病例视为未完成术前讨论。",
  "significance": "反映术前讨论完成情况。",
  "default_profile": "HXZD-008-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-008-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "surgery_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "完成术前讨论的手术例数",
      "numerator_caliber": "1、单位时间完成手术的患者中，术前讨论记录（病历）完成数\n2、说明：手术患者判断时，只需要统计手术类型=手术、介入治疗，排除诊断性操作、治疗性操作的数据\n4、一个患者多次手术，统计为多次。\n5、术前讨论记录完成定义：由于手术医嘱跟术前讨论记录没有关联关系，按医嘱开立时间往前48小时内是否有术前讨论记录判断。",
      "denominator_rule": "同期手术总例数",
      "denominator_caliber": "单位时间内完成的手术总例数（手术结束时间取医生站，排除急诊手术）",
