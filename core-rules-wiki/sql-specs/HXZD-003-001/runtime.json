{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-003-001",
  "rule_name": "急会诊及时到位率",
  "category": "会诊制度",
  "definition": "急会诊请求发出后，10分钟内到达现场的急会诊次数占同期急会诊总次数的比例。",
  "formula": "分子：急会诊记录中10分钟内到位的急会诊次数\n分母：同期急会诊总次数\n公式：急会诊记录中10分钟内到位的急会诊次数 / 同期急会诊总次数 * 100%",
  "note": "急会诊范围包括当患者罹患疾病超出本科室诊疗范围和处置能力，且经评估可能随时危及生命，需要院内其他科室医师立刻协助诊疗、参与抢救所发出的会诊申请。",
  "significance": "反映急会诊制度执行的规范性。",
  "default_profile": "HXZD-003-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-003-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
