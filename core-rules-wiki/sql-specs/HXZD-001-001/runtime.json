{
  "schema_version": "hxzd-runtime-v1",
  "rule_id": "HXZD-001-001",
  "rule_name": "患者入院48小时内转科的比例",
  "category": "首诊负责制度",
  "definition": "入院48小时内转科患者人次数占同期入院患者总人次数的比例。",
  "formula": "分子：入院48小时内转科患者人次数\n分母：同期入院患者总人次数\n公式：入院48小时内转科患者人次数/同期入院患者总人次数 * 100%",
  "note": "本指标不包括患者转入/转出ICU的情况。",
  "significance": "反映首诊医师和首诊科室对患者病情评估的充分性。",
  "default_profile": "HXZD-001-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-001-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "admitted_to_ward_at",
      "patient_scope": [
        "inpatient_current",
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "lower_is_better",
      "numerator_rule": "入院48小时内转科患者人次数",
      "numerator_caliber": "1、统计患者入区时间在48小时内发生转科的患者人数，按人数统计，一个人48小时多次转科，算1次（不包括患者转入/转出ICU的情况）\n2、转科数据：取护士住院转科表转出数据，不包含转区数据。（该表数据为护士操作确认转科/转区后生成的）\n3、转科定义：患者流转类型=转科，或流转类型=转区（转入科室≠转出科室），即转科前后科室不相同。",
      "denominator_rule": "同期入院患者总人次数",
      "denominator_caliber": "单位时间内入区的患者总人次",
      "configurable_parameters": "无。",
