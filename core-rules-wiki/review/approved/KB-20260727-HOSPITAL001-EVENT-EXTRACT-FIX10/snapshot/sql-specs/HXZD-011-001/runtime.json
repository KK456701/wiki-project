{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-011-001",
  "rule_name": "手术医师手术时间重合率",
  "category": "手术安全核查制度",
  "definition": "同一时间内手术医师为同一人的手术例数占同期住院患者手术总例数的比例。",
  "formula": "分子：同一时间内手术医师为同一人的手术例数\n分母：同期住院患者手术总例数\n公式：同一时间内手术医师为同一人的手术例数 / 同期住院患者手术总例数 * 100%",
  "note": "本指标中\"同一时间\"是指手术未结束时间与其他手术开始时间重合。",
  "significance": "反映手术医师参与手术安全核查情况。",
  "unit": "percentage",
  "default_profile": "HXZD-011-001-company-default",
  "profiles": [
    {
