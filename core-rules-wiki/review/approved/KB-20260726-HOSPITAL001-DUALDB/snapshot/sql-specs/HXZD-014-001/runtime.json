{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-014-001",
  "rule_name": "危急值报告时间",
  "category": "危急值报告制度",
  "definition": "将出现危急值到临床科室获取危急值的时间，由长到短排序后取其中位数。",
  "formula": "危急值报告时间(中位数) = X(n+1)/2, n为奇数；\n危急值报告时间(中位数) = (Xn/2 + Xn/2+1)/2, n为偶数",
  "note": "1. n为实际报告的危急值项目数; X为出现危急值到临床科室获取危急值的时间。\n2.分别计算住院、门诊、急诊危急值报告时间。",
  "significance": "反映危急值上报的效率。",
  "default_profile": "HXZD-014-001-company-default",
