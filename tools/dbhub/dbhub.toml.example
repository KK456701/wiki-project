# 复制为 dbhub.local.toml 后填写真实连接信息。
# 本地文件已被 .gitignore 忽略，不要提交账号、密码或公司网络地址。

[[sources]]
# 业务库：源业务数据，只允许只读查询。
id = "winex_all_dev"
type = "sqlserver"
host = "CHANGE_ME"
port = 1433
database = "WiNEX_All_DEV"
user = "readonly_user"
password = "CHANGE_ME"
sslmode = "disable"
query_timeout = 30
connection_timeout = 15
lazy = true

[[sources]]
# 真实库：抽取后的核对数据，只允许只读查询；数据写入由独立抽取网关负责。
id = "winex_aima"
type = "sqlserver"
host = "CHANGE_ME"
port = 1433
database = "winex_aima"
user = "readonly_user"
password = "CHANGE_ME"
sslmode = "disable"
query_timeout = 30
connection_timeout = 15
lazy = true

[[tools]]
name = "execute_sql"
source = "winex_all_dev"
readonly = true
max_rows = 20001

[[tools]]
name = "search_objects"
source = "winex_all_dev"

[[tools]]
name = "execute_sql"
source = "winex_aima"
readonly = true
max_rows = 20001

[[tools]]
name = "search_objects"
source = "winex_aima"
