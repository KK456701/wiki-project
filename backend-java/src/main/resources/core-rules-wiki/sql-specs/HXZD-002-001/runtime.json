{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-002-001",
  "rule_name": "患者入院8小时内查房率",
  "category": "三级查房制度",
  "definition": "入院8小时内开具检查或治疗医嘱的患者人次数占同期入院患者总人次数的比例。",
  "formula": "分子：入院8小时内开具检查或治疗医嘱的患者人次数\n分母：同期入院患者总人次数\n公式：入院8小时内开具检查或治疗医嘱的患者人次数 / 同期入院患者总人次数 * 100%",
  "note": "——",
  "significance": "反映查房的及时性。",
  "default_profile": "HXZD-002-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-002-001-company-default",
      "profile_name": "推荐方案：公版",
