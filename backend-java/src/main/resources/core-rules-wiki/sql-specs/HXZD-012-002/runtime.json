{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-012-002",
  "rule_name": "四级手术与三级手术患者死亡率比",
  "category": "手术分级管理制度",
  "definition": "四级手术患者死亡率与三级手术患者死亡率的比。",
  "formula": "分子：四级手术患者死亡率\n分母：三级手术患者死亡率\n公式：四级手术患者死亡率 : 三级手术患者死亡率",
  "note": "各级手术患者死亡率为各级手术患者死亡人数占同期各级手术患者人数的比例。",
  "significance": "反映手术分级管理的合理性。",
  "default_profile": "HXZD-012-002-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-012-002-company-default",
      "profile_name": "推荐方案：手术数据来源：医嘱",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "surgery_at",
      "patient_scope": [
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "lower_is_better",
      "numerator_rule": "四级手术患者死亡率",
      "numerator_caliber": "1、单位时间内完成四级手术的患者且死亡的人数/单位时间完成的四级手术例数\n2、四级手术相关数据来源为【医生站】，统计单位时间内完成四级手术的患者人数（一个患者多次四级手术，统一为1）。\n3、说明：一个患者在院期间做了三级手术和四级手术，若患者死亡，则按高等级手术归属。\n4、死亡患者取病案首页中转归情况=死亡",
      "denominator_rule": "三级手术患者死亡率",
      "denominator_caliber": "1、单位时间内完成三级手术的患者且死亡的人数/单位时间完成的三级手术例数\n2、三级手术相关数据来源为【医生站】，统计单位时间内完成三级手术的患者人数（一个患者多次四级手术，统一为1）。\n3、说明：一个患者在院期间做了三级手术和四级手术，若患者死亡，则按高等级手术归属。\n4、死亡患者取病案首页中转归情况=死亡",
      "configurable_parameters": "无。",
