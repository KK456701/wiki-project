{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-003-004",
  "rule_name": "普通会诊有效率",
  "category": "会诊制度",
  "definition": "普通会诊结束后开具相关医嘱的次数占同期普通会诊总次数的比例。",
  "formula": "分子：普通会诊结束后开具相关医嘱的次数\n分母：同期普通会诊患者总次数\n公式：普通会诊结束后开具相关医嘱的次数 / 同期普通会诊患者总次数 * 100%",
  "note": "本指标中普通会诊结束后开具相关医嘱情况统计方法为在申请普通会诊后24小时内开具相关医嘱。",
  "significance": "反映普通会诊意见的有效性和普通会诊申请的合理性。",
  "default_profile": "HXZD-003-004-company-default",
  "profiles": [
