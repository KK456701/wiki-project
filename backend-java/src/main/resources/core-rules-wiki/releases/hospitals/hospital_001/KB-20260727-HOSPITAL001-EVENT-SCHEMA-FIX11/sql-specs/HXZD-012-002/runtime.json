{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-012-002",
  "rule_name": "四级手术与三级手术患者死亡率比",
  "category": "手术分级管理制度",
  "definition": "四级手术患者死亡率与三级手术患者死亡率的比。",
  "formula": "四级手术患者死亡率 = 四级手术死亡患者数 ÷ 四级手术患者数\n三级手术患者死亡率 = 三级手术死亡患者数 ÷ 三级手术患者数\n最终结果 = 四级手术患者死亡率 ÷ 三级手术患者死亡率\n三级手术患者死亡率为0时结果为无样本",
  "note": "各级手术患者死亡率为各级手术患者死亡人数占同期各级手术患者人数的比例。",
  "significance": "反映手术分级管理的合理性。",
  "unit": "ratio",
  "default_profile": "HXZD-012-002-company-default",
