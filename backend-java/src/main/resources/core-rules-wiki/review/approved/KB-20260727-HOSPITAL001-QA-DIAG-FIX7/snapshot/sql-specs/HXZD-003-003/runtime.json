{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-003-003",
  "rule_name": "普通会诊及时完成率",
  "category": "会诊制度",
  "definition": "普通会诊24小时内完成次数占同期普通会诊总次数的比例。",
  "formula": "分子：普通会诊24小时内完成次数\n分母：同期普通会诊总次数\n公式：普通会诊24小时内完成次数 / 同期普通会诊总次数 * 100%",
  "note": "病历中会诊医师电子签章时间即为会诊完成时间。",
  "significance": "反映普通会诊制度执行的规范性。",
  "unit": "percentage",
  "default_profile": "HXZD-003-003-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-003-003-company-default",
      "profile_name": "推荐方案：按会诊申请科室数统计",
