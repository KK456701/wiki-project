    {
      "profile_id": "HXZD-006-001-company-default",
      "profile_name": "推荐方案：公版",
      "governance_status": "approved",
      "execution_status": "documentation_only",
      "execution_blockers": [
        "缺少经确认的医院字段契约和统一结果列映射"
      ],
      "effective_from": "2025-01-01",
      "effective_to": null,
      "owner_scope": "company",
      "hospital_ids": [
        "*"
      ],
      "time_dimension": "admitted_to_ward_at",
      "patient_scope": [
        "inpatient_discharged"
      ],
      "dedup_key": "encounter_id",
      "direction": "higher_is_better",
      "numerator_rule": "对非计划再次住院/手术患者进行疑难病例讨论的数量",
      "numerator_caliber": "1、单位时间内出区的非计划再次手术或非计划再住院患者中，有疑难病历讨论记录的患者数\n2、非计划再次入院定义：患者31天内再次住院，并且上次住院的病案首页“31天内再住院计划=无”，且患者本次入院主诊断和上次出院主诊断的诊断编码前5个字符相同（（例如诊断编码为Z51.003，则前5个字符为Z51.0））。\n4、非计划再次手术定义：取手术医嘱“非计划二次手术”标记\n5、说明：手术患者判断时，只需要统计手术类型为手术、介入治疗，排除诊断性操作、治疗性操作的数据",
      "denominator_rule": "同期非计划再次住院/手术的数量",
      "denominator_caliber": "单位时间内出区的患者，住院期间发生非计划再次手术或属于非计划再住院的患者数（一个患者最多统一为1）",
      "configurable_parameters": "无。",
