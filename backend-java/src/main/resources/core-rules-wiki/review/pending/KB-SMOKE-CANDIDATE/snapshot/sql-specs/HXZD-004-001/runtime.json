{
  "schema_version": "hxzd-runtime-v2",
  "rule_id": "HXZD-004-001",
  "rule_name": "手术患者特级护理/一级护理出院率",
  "category": "分级护理制度",
  "definition": "手术患者出院时为特级护理/一级护理级别的患者数量占同期手术患者总数量的比例。",
  "formula": "分子：手术患者出院时为特级护理/一级护理级别的患者数量\n分母：同期手术患者总数量\n公式：手术患者出院时为特级护理/一级护理级别的患者数量 / 同期手术患者总数量 * 100%",
  "note": "——",
  "significance": "反映对住院患者进行分级护理动态调整的情况。",
  "default_profile": "HXZD-004-001-company-default",
  "profiles": [
    {
      "profile_id": "HXZD-004-001-company-default",
      "profile_name": "推荐方案：公版",
